# GD Tracker & Requirement Request App - Environment Variables Template
# Copy this file to .env or .env.local and populate with your environment credentials.
# NEVER commit real secret keys, service role keys, or credentials to git repository.

# Supabase Public API Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# Application Configuration
VITE_APP_NAME="GD Tracker & Requirement Request App"
VITE_APP_ENV=production
